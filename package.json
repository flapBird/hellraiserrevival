{
  "name": "hellraiserrevival",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy:cf": "npm run build && npx --yes wrangler deploy",
    "preview:cf": "npm run build && npx --yes wrangler dev"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
